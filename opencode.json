{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      "app/**": "allow",
      "components/**": "allow",
      "data/**": "allow",
      "lib/**": "allow",
      "docs/**": "allow",
      "AGENTS.md": "allow",
      "README.md": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "rm -rf*": "deny"
    }
  }
}
